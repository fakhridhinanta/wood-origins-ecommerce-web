<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Admin Login | Wood Origins</title><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"><style>*{box-sizing:border-box}body{margin:0;background:#f5f2ef;color:#302927;font:14px/1.6 Poppins,Arial,sans-serif;min-height:100vh;display:grid;place-items:center;padding:24px}.card{width:100%;max-width:440px;background:white;padding:36px;border:1px solid #e4d9d1;border-top:5px solid #24598b;border-radius:7px;box-shadow:0 8px 30px #422e2d0a}.brand{font-size:12px;font-weight:700;letter-spacing:.18em;color:#756862}h1{font-size:25px;line-height:1.3;margin:14px 0 8px}p{color:#756862}label{display:block;margin-top:20px;font-weight:600}input{font:inherit;width:100%;padding:12px;border:1px solid #d4c9c0;border-radius:4px;margin-top:6px}button{font:600 14px Poppins,Arial,sans-serif;width:100%;padding:14px;margin-top:25px;border:0;background:#24598b;color:white;border-radius:4px;cursor:pointer}a{color:#24598b}.error{color:#a63838;background:#fff1ef;padding:12px;border-radius:4px}.back{display:block;text-align:center;margin-top:22px}</style></head><body><main class="card"><div class="brand">WOOD ORIGINS</div><h1>Admin login</h1><p>Sign in to your Ecommerce Web Dashboard.</p><!--ERROR--><form action="/admin/login" method="post"><label for="username">ID</label><input id="username" name="username" autocomplete="username" required maxlength="100"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200"><button type="submit">Log in</button></form><a class="back" href="/">Back to website</a></main></body></html>