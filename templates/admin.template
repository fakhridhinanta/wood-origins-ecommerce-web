<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>WO - Ecommerce Web Dashboard</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"><style>
:root{--ink:#302927;--muted:#756862;--line:#e4d9d1;--blue:#24598b;--cream:#f5f2ef;--brown:#4b3532}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:14px/1.5 Poppins,Arial,sans-serif}button,input,select{font:inherit}button{cursor:pointer}a{color:var(--blue);font-weight:600;text-decoration:none}.shell{display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}.sidebar{background:var(--brown);color:#fff;padding:28px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column}.brand{padding:0 14px 24px;font-size:20px;font-weight:700;letter-spacing:.05em}.brand small{display:block;color:#dcc7bd;font-size:10px;letter-spacing:.17em;font-weight:500}.sidebar nav button{display:block;width:100%;text-align:left;color:#f5ece7;background:transparent;border:0;border-radius:5px;margin:3px 0;padding:13px 14px;font-size:13px}.sidebar nav button:hover,.sidebar nav button.active{background:#ffffff25;box-shadow:inset 3px 0 #fff}.bottom{margin-top:auto;border-top:1px solid #ffffff33;padding:16px 14px;font-size:11px;color:#dfcec3}main{min-width:0;padding:38px clamp(20px,4vw,58px)}.top{display:flex;align-items:start;justify-content:space-between;gap:20px}.eyebrow{text-transform:uppercase;color:var(--blue);font-size:11px;letter-spacing:.16em;font-weight:700}h1{font-size:29px;margin:8px 0 4px;line-height:1.25}h2{font-size:17px;margin:0}h3{font-size:15px;margin:30px 0 14px}.subtitle{color:var(--muted);margin:4px 0 26px}.panel{display:none}.panel.active{display:block}.card{background:#fff;border:1px solid var(--line);border-radius:7px;box-shadow:0 4px 16px #422e2d0a;margin:0 0 22px}.head{border-bottom:1px solid var(--line);padding:19px 23px;display:flex;align-items:center;justify-content:space-between}.body{padding:22px 23px}.badge{font-size:11px;color:#52664c;background:#edf3eb;border-radius:20px;padding:5px 10px}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin-bottom:16px}.toolbar>input{flex:1;min-width:220px}.toolbar label{font-size:12px;font-weight:600}.toolbar label input{display:block}.field{margin-bottom:22px}.field label{display:block;font-weight:600;margin-bottom:7px}.field input,.field select,.toolbar input,.toolbar select{height:44px;border:1px solid #d4c9c0;border-radius:5px;padding:9px 11px;background:#fff;color:var(--ink);max-width:100%}.field input{width:100%}.field select{width:100%}.field input:disabled{background:#f5f2ef;color:#746c66}.help{font-size:12px;color:var(--muted);margin:6px 0 0}.error{font-size:12px;color:#a63838}.save{background:var(--blue);border:0;border-radius:5px;color:#fff;font-weight:600;padding:11px 17px;min-height:44px}.save:disabled{opacity:.5}.minor{background:#fff;border:1px solid #b9aca4;border-radius:5px;color:var(--brown);font-weight:600;padding:10px 16px;min-height:44px}.status{font-size:12px;color:var(--muted);margin:12px 0}.status.success{color:#237344}.status.failure{color:#b23434}.hidden{display:none!important}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.metric{border:1px solid var(--line);border-radius:5px;padding:16px}.metric strong{display:block;font-size:24px}.metric span{font-size:11px;color:var(--muted)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:5px}.data-table{border-collapse:collapse;width:100%;font-size:12px;min-width:660px}.data-table th{text-align:left;background:#f5f1ec;color:#695d56;padding:12px;white-space:nowrap}.data-table td{border-top:1px solid #eee8e2;padding:12px;vertical-align:top;max-width:220px;overflow-wrap:anywhere}.data-table tr:hover td{background:#fcfaf8}.empty{text-align:center!important;padding:30px!important;color:var(--muted)}.leads-table{min-width:1550px}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.event-row{display:grid;grid-template-columns:minmax(180px,1fr) minmax(200px,1fr) minmax(200px,1fr);gap:12px;align-items:end;margin-bottom:15px}.event-row label{font-size:12px;font-weight:600}.event-row input,.event-row select{width:100%;height:43px;border:1px solid #d4c9c0;border-radius:5px;padding:8px 10px}.event-row input:disabled{background:#f5f2ef;color:#786e69}.note{background:#f7f6f3;padding:14px 16px;border-radius:5px;color:#645b55;font-size:12px}.actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.small-action{border:0;background:transparent;color:var(--blue);font-weight:600;padding:3px 5px}.mode{font-size:11px;border-radius:20px;padding:3px 8px;background:#eaf0f7;color:var(--blue)}.mode.test{background:#fff1d9;color:#8b601e}.detail{white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px;overflow:auto}.footer{color:var(--muted);font-size:11px;padding:10px 0 28px}@media(max-width:1000px){.metrics{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:repeat(2,1fr)}.event-row{grid-template-columns:1fr 1fr}.event-row .event-label{grid-column:1/-1}}@media(max-width:650px){.shell{grid-template-columns:130px minmax(0,1fr)}.sidebar{padding:16px 6px}.brand{font-size:13px;padding:0 5px 15px}.brand small{font-size:8px}.sidebar nav button{font-size:10px;padding:10px 6px}.bottom{display:none}main{padding:20px 12px}.top{display:block}h1{font-size:22px}.body,.head{padding:16px}.form-grid,.event-row{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.metric strong{font-size:20px}}
</style></head><body><div class="shell"><aside class="sidebar"><div class="brand">WOOD ORIGINS<small>ECOMMERCE WEB</small></div><nav id="adminNav" aria-label="Admin menu"><button type="button" data-tab="analytics">◫ &nbsp; Analytics</button><button type="button" data-tab="leads">▤ &nbsp; Leads database</button><button type="button" data-tab="tracking">⚙ &nbsp; Tracking setup</button><button type="button" data-tab="whatsapp">◉ &nbsp; WhatsApp templates</button></nav><form action="/admin/logout" method="post" style="padding:16px 8px"><button class="minor" type="submit">Log out</button></form><div class="bottom">Wood Origins · Website admin</div></aside><main><div class="top"><div><div class="eyebrow">Wood Origins</div><h1>WO - Ecommerce Web Dashboard</h1></div><a href="/" target="_blank" rel="noopener">View website ↗</a></div><p class="subtitle" id="pageSubtitle">Website activity and quote performance.</p>
<section class="panel" data-panel="analytics"><div class="card"><div class="head"><h2>Analytics</h2><span class="badge">Website activity</span></div><div class="body"><div class="toolbar"><label>From<input type="date" id="dateFrom"></label><label>To<input type="date" id="dateTo"></label><button type="button" class="save" id="refreshAnalytics">Refresh</button></div><div id="metrics" class="metrics"></div><h3>Detailed event analytics</h3><div class="toolbar"><input id="eventSearch" placeholder="Search event or campaign…"></div><div class="table-wrap"><table id="eventsTable" class="data-table"></table></div><p id="eventCount" class="help"></p></div></div></section>
<section class="panel" data-panel="leads"><div class="card"><div class="head"><h2>Leads database</h2><span class="badge" id="leadCount">Loading…</span></div><div class="body"><div class="toolbar"><input id="leadSearch" placeholder="Search name, phone, campaign, ID…"><select id="leadModeFilter"><option value="">Test &amp; live</option><option value="live">Live</option><option value="test">Test</option></select><select id="leadSort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">Name A–Z</option></select><button type="button" class="save" id="refreshLeads">Refresh</button></div><div class="table-wrap"><table id="leadsTable" class="data-table leads-table"></table></div><div id="leadDetail" class="note detail hidden" style="margin-top:15px"></div></div></div></section>
<section class="panel" data-panel="tracking"><form id="settingsForm" class="card"><div class="head"><h2>Tracking IDs</h2><span class="badge">Administrator only</span></div><div class="body"><div class="field"><label for="metaPixelId">Meta Pixel ID</label><input id="metaPixelId" inputmode="numeric" placeholder="Numeric Pixel ID" disabled><p class="help">Leave blank to disable the Meta Pixel.</p><div class="error" id="metaError"></div></div><div class="field"><label for="gtmId">Google Tag Manager ID</label><input id="gtmId" placeholder="GTM-ABC1234" disabled><p class="help">Leave blank to disable GTM.</p><div class="error" id="gtmError"></div></div><p class="note">If Meta Pixel is also installed through GTM, choose one installation method to avoid duplicate tracking.</p><div class="actions" style="margin-top:18px"><button class="save" id="saveSettings" disabled>Save tracking IDs</button><span class="status" id="trackingStatus"></span></div></div></form><div class="card"><div class="head"><h2>Event name setup</h2></div><div class="body"><p class="help" style="margin-bottom:20px">Choose a fixed Meta standard event or Custom for each action. Custom names can be edited. Changes apply to new page loads and future events.</p><div id="eventConfig"></div><div class="actions"><button type="button" class="save" id="saveEvents">Save event names</button><span id="eventStatus" class="status"></span></div></div></div></section>
<section class="panel" data-panel="whatsapp"><div class="card"><div class="head"><h2 id="templateFormTitle">Add campaign hashcode</h2></div><div class="body"><p class="note">Direct WhatsApp chats use the selected product message and append a matching hashcode in brackets. Quote-form follow-up chats do not use a hashcode. Matching ignores case and small formatting differences.</p><form id="templateForm" class="form-grid" style="margin-top:18px"><div class="field"><label for="waCampaign">Campaign name</label><input id="waCampaign" required maxlength="250"></div><div class="field"><label for="waAdSet">Ad set name</label><input id="waAdSet" required maxlength="250"></div><div class="field"><label for="waAd">Ad name</label><input id="waAd" required maxlength="250"></div><div class="field"><label for="waHashcode">Hashcode</label><input id="waHashcode" required maxlength="100" pattern="[-A-Za-z0-9_]+"></div><div class="actions" style="grid-column:1/-1"><button type="submit" class="save">Save hashcode</button><button type="button" class="minor hidden" id="cancelTemplate">Cancel edit</button><span id="templateStatus" class="status"></span></div></form></div></div><div class="card"><div class="head"><h2>Saved campaign hashcodes</h2><span id="templateCount" class="badge">Loading…</span></div><div class="body"><div class="toolbar"><input id="templateSearch" placeholder="Search campaign, ad set, ad, or hashcode…"><button type="button" class="save" id="refreshTemplates">Refresh</button></div><div class="table-wrap"><table id="templatesTable" class="data-table"></table></div></div></div></section>
<div class="footer">Tracking scripts run on the public website, not on this admin page.</div></main></div><script src="/admin.js"></script></body></html>
