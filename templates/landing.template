  '<tr><td>Wear layer</td><td class="wo">0.5 mm</td><td>0.3–0.5 mm</td><td>0.1–0.2 mm</td></tr>'+
  '<tr><td>Slip resistance</td><td class="wo yes">R10</td><td>Usually none</td><td class="no">None</td></tr>'+
  '<tr><td>Install team</td><td class="wo yes">In-house</td><td class="no">Subcontracted</td><td class="no">Subcontracted</td></tr>'+
  '<tr><td>Warranty</td><td class="wo">25 years</td><td>5–10 yrs</td><td>1–2 yrs</td></tr>'+
  '<tr><td>Free site survey</td><td class="wo yes">✓</td><td class="no">Sometimes</td><td class="no">✗</td></tr></table>'+
  '<div class="cmp-note">Illustrative comparison of typical Singapore market offerings.</div>'; }
function openVisualiser(){ window.open('https://showroom.woodorigins.sg','_blank'); }
function worthItHtml(){
  const pts=[
    ['100% virgin vinyl, fiberglass-reinforced','Cheaper brands cut cost with <b>composite or recycled cores</b> that warp, curl and off-gas over time. Ours is <b>pure virgin vinyl</b> with a <b>fiberglass layer</b> for dimensional stability — it lies flat and stays flat.'],
    ['It\'s the wear layer, not the sticker price','The clear top coat takes all the wear. Ours is <b>0.5&nbsp;mm commercial-grade</b>; budget vinyl often hides 0.1–0.2&nbsp;mm that scuffs through in a few years — then it\'s a full re-do.'],
    ['Waterproof core + R10 slip rating','A <b>100% waterproof</b> core and <b>R10 slip resistance</b> — built for Singapore homes, safe underfoot even in the kitchen or near the bathroom.'],
    ['Laid by our own crew, backed 25 years','A great plank installed badly still lifts at the edges. Our <b>in-house crew</b> lays every floor and we back it <b>25 years</b> — the clearest sign we stand behind it.']
  ];
  let h='<p class="worth-intro">Not all vinyl is equal. Here\'s what actually decides whether a floor lasts — and where we don\'t cut corners:</p><div class="worth-list">';
  pts.forEach((p,i)=>{ h+=`<div class="worth-item" style="animation-delay:${(i*0.12).toFixed(2)}s"><div class="worth-num">${String(i+1).padStart(2,'0')}</div><div><div class="worth-h">${p[0]}</div><div class="worth-p">${p[1]}</div></div></div>`; });
  h+='</div><div class="worth-proof">And here\'s how the same budget stacks up:</div>'+compareTableHtml();
  return h;
}
function wizSync(){ const step=wizFlow.steps[wizStep], nx=document.getElementById('wizNext'); if(!nx)return;
  let ok=true;
  if(step.type==='single')ok=!!wizAns[step.key];
  else if(step.type==='multi')ok=(wizAns[step.key]||[]).length>0;
  else if(step.type==='contact')ok=!!((wizAns.name||'').trim()&&(wizAns.phone||'').trim()&&wizAns.consent);
  nx.disabled=!ok; nx.style.opacity=ok?'1':'.5';
}
function wizPick(i){ const step=wizFlow.steps[wizStep]; wizAns[step.key]=step.opts[i]; renderWiz(); setTimeout(wizNext,150); }
function wizToggle(i){ const step=wizFlow.steps[wizStep], a=wizAns[step.key]||[], v=step.opts[i], j=a.indexOf(v); if(j>=0)a.splice(j,1);else a.push(v); wizAns[step.key]=a; renderWiz(); }
function wizBack(){ for(let j=wizStep-1;j>=0;j--){ if(stepOn(wizFlow.steps[j])){wizStep=j;renderWiz();return;} } }
function wizNext(){ const step=wizFlow.steps[wizStep];
  if((step.type==='single'&&!wizAns[step.key])||(step.type==='multi'&&!(wizAns[step.key]||[]).length)||(step.type==='contact'&&!((wizAns.name||'').trim()&&(wizAns.phone||'').trim()&&wizAns.consent))){if(wizKey==='quote')track('form_validation_error',{pageSection:step.key});return;}
  if(wizKey==='quote'&&!completedQuoteSteps.has(wizStep)){completedQuoteSteps.add(wizStep);track('form_step_'+(wizStep+1)+'_completed',{pageSection:step.key});}
  for(let j=wizStep+1;j<wizFlow.steps.length;j++){ if(stepOn(wizFlow.steps[j])){wizStep=j;renderWiz();return;} }
}
function wizRenderRooms(){ const el=document.getElementById('wRoomsList'); if(!el)return; el.innerHTML='';
  WROOMS.forEach((r,i)=>{ const d=document.createElement('div'); d.className='room-row';
    d.innerHTML=`<input type="text" placeholder="Room (optional)" value="${wesc(r.name)}" oninput="WROOMS[${i}].name=this.value">`+
      `<input type="number" placeholder="W" value="${r.w||''}" oninput="WROOMS[${i}].w=parseFloat(this.value)||0">`+
      `<input type="number" placeholder="L" value="${r.l||''}" oninput="WROOMS[${i}].l=parseFloat(this.value)||0">`+
      `<button type="button" class="room-x" onclick="WROOMS.splice(${i},1);wizRenderRooms()" ${WROOMS.length<=1?'style="visibility:hidden"':''}>×</button>`;
    el.appendChild(d); });
}
function wizAddRoom(){ WROOMS.push({name:'',w:0,l:0}); wizRenderRooms(); }
function wizResult(){ return wizKey==='quote'?quoteResult():compareResult(); }
function quoteResult(){
  skirting=wizAns.skirting!=='No'; const nm=wesc(wizAns.name||'you');
  let sqft=0; WROOMS.forEach(r=>{ if(r.w>0&&r.l>0) sqft+=r.w*r.l*10.7639; }); sqft=Math.round(sqft);
  const f=n=>'$'+n.toLocaleString('en-SG',{minimumFractionDigits:2,maximumFractionDigits:2});
  if(!sqft) return `<div class="wiz-done">✓</div><div class="wiz-rtitle">Almost there, ${nm}</div><p class="wiz-rtext">Add a room size and we'll estimate on the spot.</p>`;
  const billed=Math.round(sqft*1.08), p=effPsf(), material=billed*p;
  const ex=wizAns.existing; let rem=0,hack=0,scr=0; const notes=[];
  if((ex==='Laminate'||ex==='Vinyl')&&wizAns.removeLV==='Yes, remove it') rem=sqft*1;
  if(ex==='Parquet / timber'){
    if(wizAns.hacking==='Yes') hack=sqft*3.5;
    if(wizAns.screed==='Yes') scr=sqft*6;
    if(wizAns.hacking==='Not sure'||wizAns.screed==='Not sure') notes.push('Hacking / screed to be confirmed on your free site survey.');
  }
  const sub=material+rem+hack+scr, gst=sub*0.09, grand=sub+gst, dep=grand*0.5;
  return `<div class="wiz-done">✓</div><div class="wiz-rtitle">Your indicative quote</div>
    <img class="wiz-hero-img" src="${sku.img}" alt="${wesc(sku.name)}">
    <p class="wiz-rtext">${wesc(sku.name)} · ${billed} sqft incl. 8% wastage · ${skirting?'with skirting':'no skirting'}</p>
    <div class="q-result">
      <div class="rrow"><span>${billed} sqft × ${f(p)}/sqft (incl. install)</span><span>${f(material)}</span></div>
      ${rem?`<div class="rrow"><span>Remove laminate/vinyl · $1.00/sqft</span><span>${f(rem)}</span></div>`:''}
      ${hack?`<div class="rrow"><span>Hacking · $3.50/sqft</span><span>${f(hack)}</span></div>`:''}
      ${scr?`<div class="rrow"><span>Screed &amp; level · $6.00/sqft</span><span>${f(scr)}</span></div>`:''}
      <div class="rrow"><span>GST (9%)</span><span>${f(gst)}</span></div>
      <div class="rrow tot"><span>Estimated total</span><span>${f(grand)}</span></div>
      <div class="rrow"><span>50% deposit to book</span><span>${f(dep)}</span></div>
    </div>
    <p class="wiz-fine">A Wood Origins sales rep will get in touch with ${nm} to confirm details and finalise your quote. ${notes.join(' ')} Indicative only — firm price confirmed free on-site.</p>`;
}
const PALETTE_MAP={'🍯 Honey oak':['Valley Oak','Aria Oak','Rustic Oak'],'🏖️ Pale sand':['Cotton Oak','Blanche Oak','Linen Oak'],'☕ Rich espresso':['Chestnut Oak','Cellar Oak','Vecchio Oak'],'🌫️ Cool grey':['Mystic Grey Oak','Portland Grey','Whisper Oak'],'🪨 Stone & marble':['Carrera Oak','Pebble','Roman Travertine']};
function toneFor(n){ const s=SW.find(x=>x[0]===n); return s?TONE[s[2]]:TONE.honey; }
function compareResult(){
  const picks=PALETTE_MAP[wizAns.palette]||['Valley Oak','Cotton Oak','Chestnut Oak'];
  const chips=picks.map(n=>{const c=toneFor(n); const s=SW.find(x=>x[0]===n); const code=s&&s[3]?s[3]:''; return `<div class="mood-chip"><div class="mood-tile" style="background:repeating-linear-gradient(0deg,${c[0]} 0 25%,${c[1]} 25% 50%,${c[2]} 50% 75%,${c[3]} 75% 100%)"></div><span>${wesc(n)}${code?'<em>'+wesc(code)+'</em>':''}</span></div>`;}).join('');
  const nm=wesc(wizAns.name||'you'), mood=wesc((wizAns.mood||'').replace(/^\S+\s/,'').toLowerCase()), style=wesc((wizAns.style||'').toLowerCase());
  return `<div class="wiz-done" style="background:var(--blue);">✨</div><div class="wiz-rtitle">Your dream-floor moodboard</div>
    <p class="wiz-rtext">${nm}, your <b>${mood||'signature'}</b>${style?', '+style:''} look calls for these three finishes:</p>
    <div class="moodboard">${chips}</div>
    <p class="wiz-fine"><b>Now make it real →</b> upload a photo of your room and see these on your actual floor.</p>`;
}
function wizCapture(){
  if(wizSent) return; wizSent=true;
  const nm=wizAns.name||'', ph=wizAns.phone||'';
  if(wizKey==='quote') submitLead('quote_submitted',{...wizAns,name:nm,phone:ph,sku:sku.name,rooms:WROOMS}).catch(()=>{wizSent=false;});
}
function wizSend(){
  const nm=wizAns.name||'', ph=wizAns.phone||'';
  let msg;
  if(wizKey==='quote'){
    const rooms=WROOMS.filter(r=>r.w&&r.l).map(r=>(r.name||'Room')+' '+r.w+'×'+r.l).join(', ');
    msg="Hi Wood Origins! I'd like to lock in my quote.\n\nName: "+nm+"\nMobile: "+ph+"\nFloor: "+sku.name+"\nRooms: "+rooms+"\nSkirting: "+(wizAns.skirting||'-')+"\nExisting floor: "+(wizAns.existing||'-');
  } else {
    msg="Hi Wood Origins! I did the dream-floor quiz — here are my picks.\n\nName: "+nm+"\nMobile: "+ph+"\nMood: "+(wizAns.mood||'')+"\nPalette: "+(wizAns.palette||'')+"\nStyle: "+(wizAns.style||'');
  }
  wizCapture(); closeWiz(); return openWA(msg,wizKey!=='quote');
}
document.getElementById('wizModal').addEventListener('click',e=>{if(e.target.id==='wizModal')closeWiz();});

setSku(SKUS[0]);setMode('si');renderRooms();renderFin();buildStrip();document.addEventListener('click',e=>{if(!e.target.closest('.sw-dd'))document.querySelectorAll('.sw-dd.open').forEach(x=>x.classList.remove('open'));});
/* clean floor close-ups on the "Find your finish" family cards */
const FAMIMG={"wood":"images/img-100.jpg","herr":"images/img-101.jpg","stone":"images/img-102.jpg"};
[['fam-wood','wood'],['fam-herr','herr'],['fam-stone','stone']].forEach(function(p){var el=document.querySelector('.'+p[0]);var img=FAMIMG[p[1]];if(el&&img){el.style.background="url('"+img+"') center/cover";}});
</script>
