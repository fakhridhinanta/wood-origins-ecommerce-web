let ROOMS=[{name:'Living / Dining',w:5,l:4},{name:'Bedroom',w:3,l:3}];
function renderRooms(){
  const el=document.getElementById('roomsList'); if(!el) return; el.innerHTML='';
  ROOMS.forEach((r,i)=>{
    const d=document.createElement('div'); d.className='room-row';
    d.innerHTML=`<input type="text" placeholder="Room (optional)" value="${r.name||''}" oninput="ROOMS[${i}].name=this.value">`+
      `<input type="number" placeholder="W" value="${r.w||''}" oninput="ROOMS[${i}].w=parseFloat(this.value)||0;calcQuote()">`+
      `<input type="number" placeholder="L" value="${r.l||''}" oninput="ROOMS[${i}].l=parseFloat(this.value)||0;calcQuote()">`+
      `<button type="button" class="room-x" title="Remove" onclick="ROOMS.splice(${i},1);renderRooms();calcQuote()" ${ROOMS.length<=1?'style="visibility:hidden"':''}>×</button>`;
    el.appendChild(d);
  });
}
function addRoom(){ ROOMS.push({name:'',w:0,l:0}); renderRooms(); calcQuote(); }
function calcQuote(){
  const unit=document.getElementById('qu').value, removal=document.getElementById('qr').value==='1';
  let sqft=0;
  ROOMS.forEach(r=>{ if(r.w>0&&r.l>0){ sqft += unit==='ft' ? r.w*r.l : (r.w*r.l)*10.7639; } });
  sqft=Math.round(sqft);
  const billed=Math.round(sqft*1.08);
  let material, breakdown;
  if(mode==='si'){ const p=effPsf(); material=billed*p; breakdown=`${billed} sqft × $${p.toFixed(2)}/sqft (incl. install${skirting?' + skirting':', no skirting'})`; }
  else{ const boxes=Math.ceil(billed/23); material=boxes*SO_BOX; breakdown=`${boxes} box(es) × $${SO_BOX.toFixed(2)} (23 sqft/box)`; }
  const rem=removal?sqft*1:0, sub=material+rem, gst=sub*0.09, grand=sub+gst, dep=grand*0.5;
  const f=n=>'$'+n.toLocaleString('en-SG',{minimumFractionDigits:2,maximumFractionDigits:2});
  document.getElementById('qResult').innerHTML=
    `<div class="rrow"><span>Area (${sqft} sqft + 8% wastage)</span><span>${billed} sqft</span></div>`+
    `<div class="rrow"><span>${breakdown}</span><span>${f(material)}</span></div>`+
    (rem?`<div class="rrow"><span>Remove old floor</span><span>${f(rem)}</span></div>`:'')+
    `<div class="rrow"><span>GST (9%)</span><span>${f(gst)}</span></div>`+
    `<div class="rrow tot"><span>Estimated total</span><span>${f(grand)}</span></div>`+
    `<div class="rrow"><span>50% deposit to book</span><span>${f(dep)}</span></div>`;
}

