function pickSw(o){
  const r=RENDER[o.name];
  const s={ id:'sw-'+(o.code||o.name), name:o.name, code:o.code||'—',
    col: r?r.col:(o.type==='Herringbone'?'Herringbone · LVT':o.type==='Stone'?'Stone Look · LVT':'Wood Texture · LVT'),
    psf: o.type==='Herringbone'?7.50:6.00,
    img: (r&&r.img)||RIMG[o.name]||document.getElementById('mainImg').src };
  swTab=o.type;
  setSku(s);
  buildStrip(true);
}
function buildStrip(keepTab){
  const wrap=document.getElementById('swatches'); wrap.innerHTML='';
  const activeId='sw-'+((sku.code&&sku.code!=='—')?sku.code:sku.name);
  // Default the selector to the finish type that holds the active SKU.
  if(!keepTab||!swTab){ swTab=(SW_TYPES.find(([k])=>SW.some(s=>s[1]===k&&('sw-'+(s[3]||s[0]))===activeId))||SW_TYPES[0])[0]; }
  // Type selector — obvious segmented control (Wood texture / Herringbone / Stone).
  const seglab=document.createElement('div'); seglab.className='sw-seglab'; seglab.textContent='Choose your finish type';
  wrap.appendChild(seglab);
  const seg=document.createElement('div'); seg.className='sw-seg';
  SW_TYPES.forEach(([key,label])=>{
    const items=SW.filter(s=>s[1]===key);
    const b=document.createElement('button'); b.type='button'; b.className='sw-seg-btn'+(key===swTab?' active':'');
    b.innerHTML=`<span class="t">${label}</span><span class="c">${items.length} designs</span>`;
    b.onclick=()=>{ if(typeOf(sku.name)!==key){ const f=SW.find(s=>s[1]===key); if(f) pickSw({name:f[0],type:f[1],tone:f[2],code:f[3]}); } else { swTab=key; buildStrip(true); } };
    seg.appendChild(b);
  });
  wrap.appendChild(seg);
  // Currently-selected finish note (persists across tabs).
  const cur=document.createElement('div'); cur.className='sw-cur';
  cur.innerHTML=`Selected: <b>${sku.name}${sku.code&&sku.code!=='—'?' · '+sku.code:''}</b>`;
  wrap.appendChild(cur);
  // Swatches for the chosen type only.
  const row=document.createElement('div'); row.className='sw-row';
  SW.filter(s=>s[1]===swTab).forEach(s=>{
    const o={name:s[0],type:s[1],tone:s[2],code:s[3]};
    const c=TONE[o.tone];
    const bg=RPLANK[o.name]?`background:url('${RPLANK[o.name]}') center/cover`:`background:${RCOL[o.name]||c[1]}`;
    const d=document.createElement('div'); d.className='gsw'; d.dataset.id='sw-'+(o.code||o.name); d.title=o.name+(o.code?' · '+o.code:'');
    d.innerHTML=`<div class="gtile" style="${bg}"></div><span>${o.name}${o.code?'<em>'+o.code+'</em>':''}</span>`;
    d.onclick=()=>pickSw(o);
    row.appendChild(d);
  });
  wrap.appendChild(row);
  const active=wrap.querySelector('[data-id="'+activeId+'"]'); if(active) active.classList.add('active');
}
