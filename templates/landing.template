<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Valley Oak LVT — Vinyl Done Properly | Wood Origins</title>
<meta name="description" content="Luxury vinyl flooring, done properly — 100% virgin vinyl, fiberglass core, R10 slip-resistant, 25-year warranty. Supplied & installed by Wood Origins. Get your quote in a minute.">
<meta property="og:title" content="Wood Origins — Vinyl Done Properly">
<meta property="og:description" content="100% virgin vinyl, installed by our own crew, backed 25 years. The floor you'll install last. Get a quote or find your finish in a minute.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://woodorigins.sg/">
<!-- TODO: add <meta property="og:image" content="https://woodorigins.sg/..."> for the ad link preview -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" id="dupvp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#2b2523;        /* near-black brown text */
  --brown:#422E2D;
  --brown-soft:#6b5651;
  --blue:#235787;       /* WO button blue */
  --blue-dark:#1b4468;
  --taupe:#d8ccc2;      /* hero band */
  --cream:#F4EFEA;
  --page:#f6f4f1;
  --line:#e7ded5;
  --grey:#8a7d79;
  --wa:#25D366;
  --r:2px; --maxw:1200px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:"Poppins",-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0;background:var(--page);color:var(--ink);line-height:1.6;font-weight:400;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
.eyebrow{text-transform:uppercase;letter-spacing:2.5px;font-size:11px;font-weight:600;color:var(--brown-soft);}

/* NAV */
.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);}
.nav-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:70px;gap:20px;}
.logo{font-weight:700;font-size:22px;color:var(--ink);letter-spacing:.2px;}
.nav-links{display:flex;gap:30px;justify-content:center;font-size:12.5px;font-weight:500;color:var(--ink);text-transform:uppercase;letter-spacing:1px;}
.nav-links a:hover{color:var(--blue);}
.nav-links .caret{font-size:9px;opacity:.6;}
.nav-right{display:flex;align-items:center;gap:18px;justify-content:flex-end;font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--ink);}
.nav-right a:hover{color:var(--blue);}
.nav-right .cart{position:relative;font-size:16px;}
.cart-count{position:absolute;top:-8px;right:-9px;background:var(--blue);color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 3px;}
@media(max-width:820px){.nav-links{display:none;}.nav-inner{grid-template-columns:1fr auto;}}

/* HERO */
.hero{position:relative;height:440px;overflow:hidden;background:var(--taupe);}
.hero img{width:100%;height:100%;object-fit:cover;object-position:center 60%;}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,25,22,.35),rgba(30,25,22,.05));}
.hero-txt{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-align:center;z-index:2;text-shadow:0 2px 18px rgba(0,0,0,.35);}
.hero-txt .series{font-size:56px;line-height:1;font-weight:300;}
.hero-txt .series b{font-weight:700;}
.hero-txt .vf{margin-top:10px;font-size:17px;letter-spacing:9px;font-weight:500;text-transform:uppercase;}
@media(max-width:820px){.hero{height:300px;}.hero-txt .series{font-size:38px;}.hero-txt .vf{font-size:13px;letter-spacing:5px;}}

/* BREADCRUMB */
.crumb{font-size:11px;color:var(--grey);padding:20px 0 0;text-transform:uppercase;letter-spacing:1px;}
.crumb a:hover{color:var(--blue);}

/* PDP */
.pdp{display:grid;grid-template-columns:1.15fr 1fr;gap:54px;padding:22px 0 50px;align-items:start;}
@media(max-width:920px){.pdp{grid-template-columns:1fr;gap:30px;}}
.gallery{position:sticky;top:20px;}
@media(max-width:920px){.gallery{position:static;}}
.main-img{position:relative;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;aspect-ratio:4/5;background:#eee;}
.main-img img{width:100%;height:100%;object-fit:cover;}
.room-btn{position:absolute;bottom:14px;right:14px;background:rgba(255,255,255,.95);border:1px solid var(--line);border-radius:var(--r);padding:10px 14px;font-size:11px;font-weight:600;color:var(--brown);cursor:pointer;display:flex;gap:6px;align-items:center;text-transform:uppercase;letter-spacing:.6px;font-family:inherit;box-shadow:0 2px 10px rgba(0,0,0,.12);}
.room-btn:hover{background:#fff;color:var(--blue);}
.disc{font-size:11px;color:var(--grey);margin-top:8px;font-style:italic;}
.swatch-lab{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.2px;color:var(--brown-soft);margin:18px 0 10px;}
.swatches{display:flex;gap:12px;flex-wrap:wrap;}
.sw{width:74px;cursor:pointer;text-align:center;}
.sw .chip{width:74px;height:74px;border-radius:var(--r);border:2px solid transparent;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08);}
.sw.active .chip{border-color:var(--brown);}
.sw span{display:block;font-size:9.5px;color:var(--grey);margin-top:5px;line-height:1.25;text-transform:uppercase;letter-spacing:.3px;}
.sw-tabs{display:flex;gap:9px;margin:2px 0 2px;}
.sw-tab{flex:1;background:none;border:1px solid var(--line);border-radius:var(--r);padding:9px 10px 8px;cursor:pointer;text-align:left;font-family:inherit;transition:.15s;}
.sw-tab:hover{border-color:var(--brown-soft);}
.sw-tab.active{border-color:var(--brown);background:#fbf8f4;}
.sw-tab-top{display:flex;align-items:baseline;justify-content:space-between;gap:6px;font-size:10px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--brown);}
.sw-tab-top em{font-style:normal;font-weight:400;font-size:9.5px;color:var(--grey);letter-spacing:.4px;}
.sw-tab.active .sw-tab-top{color:var(--blue);}
.sw-tab-strip{display:flex;height:11px;border-radius:2px;overflow:hidden;margin-top:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);}
.sw-tab-strip i{flex:1;}
.sw-cur{font-size:9.5px;color:var(--grey);margin:11px 0 1px;text-transform:uppercase;letter-spacing:.4px;}
.sw-cur b{color:var(--blue);font-weight:500;}
.sw-row{display:flex;flex-wrap:wrap;gap:9px;padding:8px 0 2px;}
.sw-dd{position:relative;max-width:290px;margin:2px 0 2px;}.sw-dd-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:11px 14px;cursor:pointer;font-family:inherit;font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--brown);}.sw-dd-btn:hover{border-color:var(--brown-soft);}.sw-dd-btn em{font-style:normal;font-weight:400;color:var(--grey);letter-spacing:.3px;margin-left:8px;}.sw-dd-btn .chev{transition:.2s;font-size:10px;}.sw-dd.open .sw-dd-btn{border-color:var(--brown);}.sw-dd.open .sw-dd-btn .chev{transform:rotate(180deg);}.sw-dd-menu{display:none;position:absolute;top:calc(100% + 5px);left:0;right:0;z-index:20;background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:0 10px 28px rgba(66,46,45,.16);overflow:hidden;}.sw-dd.open .sw-dd-menu{display:block;}.sw-dd-opt{width:100%;display:flex;flex-direction:column;gap:6px;background:none;border:0;border-bottom:1px solid var(--line);padding:10px 14px;cursor:pointer;font-family:inherit;text-align:left;}.sw-dd-opt:last-child{border-bottom:0;}.sw-dd-opt:hover{background:#fbf8f4;}.sw-dd-opt.active{background:#f4efea;}.sw-dd-opt .lab{font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--brown);}.sw-dd-opt .lab em{font-style:normal;font-weight:400;color:var(--grey);margin-left:8px;letter-spacing:.3px;}.sw-dd-opt .mstrip{display:flex;height:9px;border-radius:2px;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);}.sw-dd-opt .mstrip i{flex:1;}.sw-seglab{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--grey);margin:2px 0 9px;}.sw-seg{display:flex;gap:8px;margin-bottom:6px;}.sw-seg-btn{flex:1;display:flex;flex-direction:column;gap:3px;align-items:center;justify-content:center;padding:12px 8px;background:#fff;border:1.5px solid var(--line);border-radius:var(--r);cursor:pointer;font-family:inherit;transition:.15s;}.sw-seg-btn:hover{border-color:var(--brown-soft);}.sw-seg-btn.active{border-color:var(--brown);background:var(--brown);}.sw-seg-btn .t{font-size:12.5px;font-weight:600;letter-spacing:.4px;text-transform:uppercase;color:var(--brown);}.sw-seg-btn.active .t{color:#fff;}.sw-seg-btn .c{font-size:9.5px;letter-spacing:.4px;text-transform:uppercase;color:var(--grey);}.sw-seg-btn.active .c{color:rgba(255,255,255,.82);}
.gsw{width:56px;cursor:pointer;text-align:center;}
.gsw .gtile{width:56px;height:56px;border-radius:var(--r);border:2px solid transparent;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08);transition:.15s;}
.gsw.active .gtile{border-color:var(--brown);}
.gsw:hover .gtile{box-shadow:0 4px 12px rgba(66,46,45,.18);}
.gsw span{display:block;font-size:8px;color:var(--grey);margin-top:4px;line-height:1.2;text-transform:uppercase;letter-spacing:.2px;}
.gsw span em{display:block;font-style:normal;font-size:7.5px;letter-spacing:.5px;opacity:.75;margin-top:1px;}

/* BUY BOX */
.buy .collection{color:var(--brown-soft);}
.buy h1{margin:6px 0 2px;font-size:34px;font-weight:700;color:var(--ink);line-height:1.1;text-transform:uppercase;letter-spacing:.5px;}
.buy .code{font-size:12px;color:var(--grey);letter-spacing:1px;margin-bottom:14px;}
.buy .desc{font-size:14px;color:var(--brown-soft);margin:0 0 16px;}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;}
.chip-spec{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:6px 11px;font-size:11px;color:var(--ink);text-transform:uppercase;letter-spacing:.5px;font-weight:500;}

.ecom{border:1px solid var(--line);border-top:3px solid var(--blue);border-radius:var(--r);background:#fff;padding:20px;margin-bottom:18px;}
.ecom .tagnew{display:inline-block;background:var(--cream);color:var(--brown);font-size:9.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;padding:4px 9px;border-radius:20px;margin-bottom:12px;}
.mode-toggle{display:inline-flex;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin-bottom:14px;width:100%;}
.mode-toggle button{flex:1;border:none;background:#fff;padding:11px 10px;font-size:11.5px;font-weight:600;color:var(--grey);cursor:pointer;text-transform:uppercase;letter-spacing:.6px;font-family:inherit;}
.mode-toggle button.active{background:var(--brown);color:#fff;}
.price{font-size:30px;font-weight:700;color:var(--ink);letter-spacing:-.5px;}
.price small{font-size:14px;font-weight:500;color:var(--grey);}
.price-note{font-size:12px;color:var(--brown-soft);margin-top:4px;}
.gst-note{font-size:11px;color:var(--grey);margin-top:2px;}
.cta-col{display:flex;flex-direction:column;gap:12px;margin-top:16px;}
.ecom .price-lite{margin-bottom:0;}
.ecom .sample-note{line-height:1.6;}
.ecom .cta-links{margin-top:4px;}
.btn{border:none;border-radius:var(--r);padding:15px 18px;font-size:12.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;transition:.15s;text-transform:uppercase;letter-spacing:.9px;font-family:inherit;}
.btn-primary{background:var(--blue);color:#fff;}
.btn-primary:hover{background:var(--blue-dark);}
.btn-outline{background:#fff;color:var(--brown);border:1.5px solid var(--brown);}
.btn-outline:hover{background:var(--cream);}
.btn-wa{background:var(--wa);color:#fff;}
.btn-wa:hover{filter:brightness(.96);}
.sample-note{font-size:11px;color:var(--grey);text-align:center;}
.btn-hero{padding:20px 18px;font-size:15px;letter-spacing:1px;box-shadow:0 8px 20px rgba(35,87,135,.28);}
.cta-secondary{display:flex;gap:9px;margin-top:6px;}
.cta-secondary .btn{flex:1;padding:13px 12px;font-size:11.5px;}
.badges{display:grid;grid-template-columns:1fr 1fr;gap:11px 16px;}
.badge{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:var(--brown-soft);}
.badge .bi{font-size:15px;}.badge b{color:var(--ink);font-weight:600;}

/* TRUST */
.trust{background:var(--brown);color:#fff;}
.trust-inner{display:flex;flex-wrap:wrap;justify-content:space-around;gap:18px;padding:32px 0;text-align:center;}
.trust-tag{text-align:center;padding:34px 0 4px;}
.tt-main{font-size:27px;font-weight:700;letter-spacing:.5px;}
.tt-sub{font-size:13.5px;opacity:.82;margin-top:7px;letter-spacing:.3px;}
.trust .n{font-size:27px;font-weight:700;}
.trust .l{font-size:10.5px;opacity:.75;letter-spacing:1.2px;text-transform:uppercase;margin-top:3px;}

/* SECTIONS */
section.blk{padding:56px 0;}
section.blk.cream{background:var(--cream);}
.blk-head{text-align:center;max-width:760px;margin:0 auto 32px;}
.blk h2{font-size:25px;font-weight:700;color:var(--ink);margin:8px 0 0;text-transform:uppercase;letter-spacing:1.2px;}
.blk .lead{color:var(--brown-soft);font-size:14.5px;margin:12px 0 0;}
.why{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
@media(max-width:820px){.why{grid-template-columns:1fr;}}
.why .w{text-align:center;}
.why .wi{width:52px;height:52px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:22px;margin:0 auto 12px;}
.why h4{margin:0 0 6px;font-size:13px;text-transform:uppercase;letter-spacing:.8px;color:var(--ink);}
.why p{margin:0;font-size:13px;color:var(--brown-soft);}

.spec{width:100%;border-collapse:collapse;font-size:14px;background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;max-width:760px;margin:0 auto;}
.spec tr{border-bottom:1px solid var(--line);}.spec tr:last-child{border-bottom:none;}
.spec td{padding:13px 18px;}
.spec td:first-child{color:var(--grey);width:44%;}
.spec td:last-child{color:var(--ink);font-weight:500;}

.faq{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:#fff;max-width:820px;margin:0 auto;}
.faq details{border-bottom:1px solid var(--line);}.faq details:last-child{border-bottom:none;}
.faq summary{padding:18px 20px;font-weight:600;font-size:13.5px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;color:var(--ink);}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:"+";font-size:20px;color:var(--blue);}
.faq details[open] summary::after{content:"–";}
.faq p{margin:0;padding:0 20px 20px;font-size:13.5px;color:var(--brown-soft);}

/* COLLECTION GRID */
.rel{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
@media(max-width:920px){.rel{grid-template-columns:repeat(2,1fr);}}
.rcard{cursor:pointer;}
.rcard .rimg{aspect-ratio:3/4;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:#eee;}
.rcard .rimg img{width:100%;height:100%;object-fit:cover;transition:.3s;}
.rcard:hover .rimg img{transform:scale(1.04);}
.rcard h4{margin:12px 0 3px;font-size:12.5px;color:var(--ink);font-weight:600;text-transform:uppercase;letter-spacing:.6px;text-align:center;}
.rcard .vm{font-size:10.5px;color:var(--blue);text-transform:uppercase;letter-spacing:1.2px;text-align:center;font-weight:600;}
.fin-tabs{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:26px;}
.fin-tab{border:1px solid var(--line);background:#fff;border-radius:var(--r);padding:10px 20px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;cursor:pointer;color:var(--brown);font-family:inherit;}
.fin-tab.active{background:var(--brown);color:#fff;border-color:var(--brown);}
.more-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:var(--brown);color:#fff;border-radius:var(--r);aspect-ratio:3/4;cursor:pointer;font-size:12px;font-weight:600;padding:14px;text-transform:uppercase;letter-spacing:.5px;line-height:1.5;}
.more-tile span{opacity:.8;font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;margin-top:6px;}
.swatch-wall{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;}
@media(max-width:820px){.swatch-wall{grid-template-columns:repeat(3,1fr);}}
.sw-chip{cursor:pointer;text-align:center;}
.sw-tile{aspect-ratio:1;border-radius:var(--r);box-shadow:inset 0 0 0 1px rgba(0,0,0,.08);transition:.15s;}
.sw-chip:hover .sw-tile{transform:scale(1.05);box-shadow:0 6px 16px rgba(66,46,45,.2);}
.sw-chip span{display:block;font-size:11px;color:var(--ink);margin-top:8px;text-transform:uppercase;letter-spacing:.3px;line-height:1.3;}
.sw-chip span em{display:block;font-style:normal;font-size:9.5px;color:var(--grey);letter-spacing:1px;margin-top:2px;}
.swatch-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-bottom:6px;}
@media(max-width:820px){.swatch-grid{grid-template-columns:repeat(3,1fr);}}
.fin-group-head{display:flex;align-items:baseline;gap:12px;margin:30px 0 16px;padding-bottom:8px;border-bottom:1px solid var(--line);}
.fin-group-head:first-child{margin-top:0;}
.fin-group-head h3{font-size:16px;font-weight:600;color:var(--ink);text-transform:uppercase;letter-spacing:1px;margin:0;}
.fin-group-head span{font-size:12px;color:var(--grey);text-transform:uppercase;letter-spacing:.6px;}
.price-lite{font-size:13px;color:var(--brown-soft);margin-bottom:16px;line-height:1.55;}
.btn-hero2{padding:16px 18px;font-size:13px;}
.cta-links{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin-top:12px;font-size:12.5px;}
.cta-links a{color:var(--blue);font-weight:600;cursor:pointer;}
.cta-links a:hover{text-decoration:underline;}
.cta-links span{color:var(--grey);}
.wiz-hero-img{width:100%;height:130px;object-fit:cover;border-radius:var(--r);margin:0 0 14px;}
.moodboard{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:8px 0 4px;padding:14px;background:var(--cream);border-radius:var(--r);}
.mood-chip{text-align:center;}
.mood-tile{aspect-ratio:3/4;border-radius:var(--r);box-shadow:inset 0 0 0 1px rgba(0,0,0,.08),0 4px 12px rgba(66,46,45,.12);}
.mood-chip span{display:block;font-size:10.5px;color:var(--ink);margin-top:7px;text-transform:uppercase;letter-spacing:.3px;line-height:1.25;}
.mood-chip span em{display:block;font-style:normal;font-size:9px;color:var(--grey);letter-spacing:1px;margin-top:2px;}
#wizProg{margin-bottom:18px;}
.wiz-bar{height:5px;background:var(--line);border-radius:20px;overflow:hidden;}
.wiz-bar>div{height:100%;background:var(--blue);transition:width .3s;}
.wiz-count{font-size:11px;color:var(--grey);margin-top:7px;text-transform:uppercase;letter-spacing:.6px;}
.wiz-q{font-size:20px;font-weight:600;color:var(--ink);margin-bottom:6px;text-wrap:balance;}
.wiz-help{font-size:12.5px;color:var(--grey);margin-bottom:16px;line-height:1.5;}
.wiz-opts{display:flex;flex-direction:column;gap:9px;}
.wiz-opt{text-align:left;padding:15px 16px;border:1.5px solid var(--line);border-radius:var(--r);background:#fff;font-size:14px;font-weight:500;color:var(--ink);cursor:pointer;font-family:inherit;transition:.12s;}
.wiz-opt:hover{border-color:var(--blue);background:var(--cream);}
.wiz-opt.sel{border-color:var(--brown);background:var(--brown);color:#fff;}
#wizFoot{display:flex;gap:10px;margin-top:22px;}
#wizFoot .btn{flex:1;}
#wizFoot .wiz-back{flex:0 0 auto;}
.wiz-done{width:46px;height:46px;border-radius:50%;background:#1f8a4c;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 12px;}
.wiz-rtitle{font-size:20px;font-weight:700;color:var(--ink);text-align:center;}
.wiz-rtext{font-size:13.5px;color:var(--brown-soft);text-align:center;margin:6px 0 14px;}
.wiz-fine{font-size:11.5px;color:var(--grey);text-align:center;margin-top:14px;line-height:1.5;}
.wiz-consent{display:flex;gap:9px;align-items:flex-start;font-size:11.5px;color:var(--brown-soft);margin-top:10px;cursor:pointer;line-height:1.5;}
