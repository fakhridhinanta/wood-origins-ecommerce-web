function stepOn(s){ return !s.when || s.when(wizAns); }
function renderWiz(){
  const step=wizFlow.steps[wizStep], prog=document.getElementById('wizProg');
  if(step.type==='result'){ prog.innerHTML=''; }
  else{
    const act=wizFlow.steps.filter(s=>stepOn(s)&&s.type!=='result'), cur=act.indexOf(step)+1, total=act.length;
    prog.innerHTML=`<div class="wiz-bar"><div style="width:${(cur/total)*100}%"></div></div><div class="wiz-count">Step ${cur} of ${total}</div>`;
  }
  let html='';
  if(step.type!=='result') html+=`<div class="wiz-q">${wesc(step.q)}</div>`;
  if(step.help) html+=`<div class="wiz-help">${wesc(step.help)}</div>`;
  if(step.type==='single') html+='<div class="wiz-opts">'+step.opts.map((o,i)=>`<button type="button" class="wiz-opt${wizAns[step.key]===o?' sel':''}" onclick="wizPick(${i})">${wesc(o)}</button>`).join('')+'</div>';
  else if(step.type==='multi') html+='<div class="wiz-opts">'+step.opts.map((o,i)=>`<button type="button" class="wiz-opt${(wizAns[step.key]||[]).includes(o)?' sel':''}" onclick="wizToggle(${i})">${wesc(o)}</button>`).join('')+'</div>';
  else if(step.type==='rooms') html+='<div id="wRoomsList"></div><button type="button" class="btn btn-outline" style="width:100%;padding:10px;font-size:11.5px;" onclick="wizAddRoom()">+ Add another room</button>';
  else if(step.type==='info') html+='<div class="wiz-info">'+worthItHtml()+'</div>';
  else if(step.type==='contact'){
    html+=`<div class="q-field"><label>Your name</label><input type="text" value="${wesc(wizAns.name)}" oninput="wizAns.name=this.value;wizSync()"></div>`;
    html+=`<div class="q-field"><label>Mobile number (WhatsApp)</label><input type="tel" placeholder="+65" value="${wesc(wizAns.phone)}" oninput="wizAns.phone=this.value;wizSync()"></div>`;
    html+=`<label class="wiz-consent"><input type="checkbox" id="wizConsent" ${wizAns.consent?'checked':''} onchange="wizAns.consent=this.checked;wizSync()"> <span>I agree to be contacted by Wood Origins about my enquiry (WhatsApp/call). No spam. <a href="https://woodorigins.sg/" target="_blank" onclick="event.stopPropagation()">Privacy</a></span></label>`;
  } else if(step.type==='result') html+=wizResult();
  document.getElementById('wizBody').innerHTML=html;
  if(step.type==='rooms') wizRenderRooms();
  let f='';
  if(step.type==='result'){
    wizCapture();
    if(wizKey==='compare') f=`<button type="button" class="btn btn-primary" onclick="openVisualiser()">🛋️ See it in my room</button><button type="button" class="btn btn-wa" onclick="wizSend()">💬 WhatsApp my picks</button>`;
    else f=`<button type="button" class="btn btn-wa" onclick="wizSend()">💬 WhatsApp my quote</button><button type="button" class="btn btn-outline wiz-back" onclick="closeWiz()">Done</button>`;
  } else {
    const back=`<button type="button" class="btn btn-outline wiz-back" onclick="wizBack()" ${wizStep===0?'style="visibility:hidden"':''}>Back</button>`;
    const label=step.type==='contact'?(wizKey==='quote'?'See my quote':'Get my recommendations'):'Continue';
    f=back+`<button type="button" class="btn btn-primary" id="wizNext" onclick="wizNext()">${label}</button>`;
  }
  document.getElementById('wizFoot').innerHTML=f; wizSync();
}
