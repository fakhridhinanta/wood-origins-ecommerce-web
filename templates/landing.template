function buildDays(){
  const el=document.getElementById('dayChips'); el.innerHTML='';
  const dn=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'], now=new Date();
  for(let i=0;i<6;i++){
    const d=new Date(now.getTime()+i*86400000);
    const lab=(i===0?'Today':i===1?'Tomorrow':dn[d.getDay()])+' '+d.getDate()+'/'+(d.getMonth()+1);
    const b=document.createElement('button'); b.type='button'; b.className='day-chip'+(i===0?' active':''); b.textContent=lab;
    b.onclick=()=>{ document.querySelectorAll('.day-chip').forEach(x=>x.classList.remove('active')); b.classList.add('active'); bkDay=lab; };
    el.appendChild(b);
  }
  bkDay='Today';
}
